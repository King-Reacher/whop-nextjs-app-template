# Heinrich & Solon Residences (student hostel site)
# Everything below is optional. With nothing set, the site runs on sample
# listings, keeps bookings in memory and skips online payment.

# WhatsApp number that receives inquiries, international format, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Supabase project (run supabase/schema.sql first). Server-side only.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Paystack secret key. Also point a webhook at /api/paystack/webhook.
PAYSTACK_SECRET_KEY=""

# Public URL of the site, used for the Paystack return link.
SITE_URL=""

# Signs student sessions and login codes. Required once Supabase is connected.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=""

# Termii, for texting sign-in codes. Without it, codes are shown on screen in
# development and in the sample-data demo, and sign-in is off in production.
TERMII_API_KEY=""
TERMII_BASE_URL=""
TERMII_SENDER_ID=""

# Only needed if you publish the Android app on the Play Store. Both values
# come from the packaging tool (PWABuilder or Bubblewrap).
ANDROID_PACKAGE_NAME=""
ANDROID_SHA256_FINGERPRINTS=""
